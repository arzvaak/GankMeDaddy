{
  "name": "gankmedaddy",
  "version": "1.4.0",
  "description": "Dota 2 Live Position-Aware Coaching Agent with voice output",
  "author": "psikoma and contributors",
  "license": "GPL-3.0-only",
  "main": "dist/electron/main.js",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc",
    "start": "electron .",
    "start:cli": "ts-node src/index.ts",
    "dev": "npm run build && electron .",
    "verify": "npm run build && electron . --smoke-test",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "lucide": "^1.28.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/node-fetch": "^2.6.11",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.gankmedaddy.coach",
    "productName": "GankMeDaddy",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "src/renderer/assets/app-emblem.ico",
        "to": "app.ico"
      }
    ],
    "win": {
      "icon": "src/renderer/assets/app-emblem.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arzvaak",
        "repo": "GankMeDaddy",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
